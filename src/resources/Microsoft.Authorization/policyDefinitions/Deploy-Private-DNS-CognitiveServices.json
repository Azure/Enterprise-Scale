{
  "name": "Deploy-Private-DNS-CognitiveServices",
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "scope": null,
  "properties": {
    "policyType": "Custom",
    "mode": "Indexed",
    "displayName": "Configure Cognitive Services, Azure OpenAI and Azure AI Foundry accounts to use private DNS zones",
    "description": "Use private DNS zones to override the DNS resolution for private endpoints to Cognitive Services accounts, including kinds 'OpenAI' and 'AIServices'. Links every provided zone: privatelink.cognitiveservices.azure.com, privatelink.openai.azure.com and privatelink.services.ai.azure.com. Interim replacement for built-in c4bc6f10-cb41-49eb-b000-d5ab82e2a091 until it supports multiple zones. Learn more at: https://aka.ms/pepdnszones.",
    "metadata": {
      "version": "1.0.0",
      "category": "Network",
      "source": "https://github.com/Azure/Enterprise-Scale/",
      "alzCloudEnvironments": [
        "AzureCloud"
      ]
    },
    "parameters": {
      "privateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for Cognitive Services account",
          "description": "The resource ID of the 'privatelink.cognitiveservices.azure.com' private DNS zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "privateDnsZoneIdOpenAI": {
        "type": "String",
        "defaultValue": "",
        "metadata": {
          "displayName": "Private DNS Zone ID for Azure OpenAI",
          "description": "The resource ID of the 'privatelink.openai.azure.com' private DNS zone. Leave empty to skip this zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "privateDnsZoneIdAIServices": {
        "type": "String",
        "defaultValue": "",
        "metadata": {
          "displayName": "Private DNS Zone ID for Azure AI Foundry (AI Services)",
          "description": "The resource ID of the 'privatelink.services.ai.azure.com' private DNS zone. Leave empty to skip this zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/privateEndpoints"
          },
          {
            "count": {
              "field": "Microsoft.Network/privateEndpoints/privateLinkServiceConnections[*]",
              "where": {
                "allOf": [
                  {
                    "field": "Microsoft.Network/privateEndpoints/privateLinkServiceConnections[*].privateLinkServiceId",
                    "contains": "Microsoft.CognitiveServices/accounts"
                  },
                  {
                    "field": "Microsoft.Network/privateEndpoints/privateLinkServiceConnections[*].groupIds[*]",
                    "equals": "account"
                  }
                ]
              }
            },
            "greaterOrEquals": 1
          }
        ]
      },
      "then": {
        "effect": "[[parameters('effect')]",
        "details": {
          "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7"
          ],
          "existenceCondition": {
            "anyOf": [
              {
                "field": "name",
                "notEquals": "deployedByPolicy"
              },
              {
                "allOf": [
                  {
                    "count": {
                      "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*]",
                      "where": {
                        "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*].privateDnsZoneId",
                        "equals": "[[parameters('privateDnsZoneId')]"
                      }
                    },
                    "greaterOrEquals": 1
                  },
                  {
                    "anyOf": [
                      {
                        "value": "[[parameters('privateDnsZoneIdOpenAI')]",
                        "equals": ""
                      },
                      {
                        "count": {
                          "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*]",
                          "where": {
                            "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*].privateDnsZoneId",
                            "equals": "[[parameters('privateDnsZoneIdOpenAI')]"
                          }
                        },
                        "greaterOrEquals": 1
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "value": "[[parameters('privateDnsZoneIdAIServices')]",
                        "equals": ""
                      },
                      {
                        "count": {
                          "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*]",
                          "where": {
                            "field": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/privateDnsZoneConfigs[*].privateDnsZoneId",
                            "equals": "[[parameters('privateDnsZoneIdAIServices')]"
                          }
                        },
                        "greaterOrEquals": 1
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "deployment": {
            "properties": {
              "mode": "incremental",
              "template": {
                "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                "contentVersion": "1.0.0.0",
                "parameters": {
                  "privateDnsZoneId": {
                    "type": "string"
                  },
                  "privateDnsZoneIdOpenAI": {
                    "type": "string"
                  },
                  "privateDnsZoneIdAIServices": {
                    "type": "string"
                  },
                  "privateEndpointName": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  }
                },
                "variables": {
                  "cognitiveServicesZoneConfig": {
                    "name": "privatelink-cognitiveservices-azure-com",
                    "properties": {
                      "privateDnsZoneId": "[[parameters('privateDnsZoneId')]"
                    }
                  },
                  "openAIZoneConfig": {
                    "name": "privatelink-openai-azure-com",
                    "properties": {
                      "privateDnsZoneId": "[[parameters('privateDnsZoneIdOpenAI')]"
                    }
                  },
                  "aiServicesZoneConfig": {
                    "name": "privatelink-services-ai-azure-com",
                    "properties": {
                      "privateDnsZoneId": "[[parameters('privateDnsZoneIdAIServices')]"
                    }
                  }
                },
                "resources": [
                  {
                    "name": "[[concat(parameters('privateEndpointName'), '/deployedByPolicy')]",
                    "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
                    "apiVersion": "2020-03-01",
                    "location": "[[parameters('location')]",
                    "properties": {
                      "privateDnsZoneConfigs": "[[concat(createArray(variables('cognitiveServicesZoneConfig')), if(empty(parameters('privateDnsZoneIdOpenAI')), createArray(), createArray(variables('openAIZoneConfig'))), if(empty(parameters('privateDnsZoneIdAIServices')), createArray(), createArray(variables('aiServicesZoneConfig'))))]"
                    }
                  }
                ]
              },
              "parameters": {
                "privateDnsZoneId": {
                  "value": "[[parameters('privateDnsZoneId')]"
                },
                "privateDnsZoneIdOpenAI": {
                  "value": "[[parameters('privateDnsZoneIdOpenAI')]"
                },
                "privateDnsZoneIdAIServices": {
                  "value": "[[parameters('privateDnsZoneIdAIServices')]"
                },
                "privateEndpointName": {
                  "value": "[[field('name')]"
                },
                "location": {
                  "value": "[[field('location')]"
                }
              }
            }
          }
        }
      }
    }
  }
}
